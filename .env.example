# Mediarr — example configuration / Exemple de configuration
# Copy this file to ".env" and fill it in. NEVER commit the real ".env".
# Copie ce fichier en ".env" et remplis-le. Ne commite JAMAIS le vrai ".env".
# Leave a service URL empty to disable that service. / Laisse l'URL vide pour désactiver un service.
# All values below are FAKE examples. / Toutes les valeurs ci-dessous sont des exemples FICTIFS.

# --- Access / Accès ---
# Token required by the app (strongly recommended). Use a long random phrase.
# Jeton exigé par l'app (fortement recommandé). Invente une longue phrase aléatoire.
ACCESS_TOKEN=change-me-to-a-long-random-phrase

# Port the server listens on inside the container. / Port d'écoute dans le conteneur.
# PORT=8080

# Folder for the app's settings (prefs.json, surveillance state). Mount a volume on it.
# Dossier des réglages de l'app (prefs.json, état de la surveillance). Monte un volume dessus.
# DATA_DIR=/data

# --- Webhooks (Radarr / Sonarr / Overseerr -> Mediarr), optional / facultatif ---
# Secret of 12+ characters presented by the services as "Authorization: Bearer <secret>".
# Secret d'au moins 12 caractères présenté par les services en « Authorization: Bearer ».
WEBHOOK_SECRET=change-me-12-chars-min
# Address of Mediarr as seen by Radarr/Sonarr/Overseerr. With both variables set, Mediarr creates
# its own "Mediarr" notification in each service at startup (can be disabled in Settings > Webhooks).
# Adresse de Mediarr vue par Radarr/Sonarr/Overseerr. Avec les deux variables, Mediarr crée lui-même
# la notification « Mediarr » dans chaque service au lancement (désactivable dans Réglages > Webhooks).
MEDIARR_URL=http://192.168.1.10:30080

# --- Services (addresses as seen from the Mediarr container) / (adresses vues depuis le conteneur) ---
RADARR_URL=http://192.168.1.10:7878
# Radarr > Settings > General > API Key
RADARR_API_KEY=0123456789abcdef0123456789abcdef

SONARR_URL=http://192.168.1.10:8989
# Sonarr > Settings > General > API Key
SONARR_API_KEY=0123456789abcdef0123456789abcdef

OVERSEERR_URL=http://192.168.1.10:5055
# Overseerr > Settings > General > API Key (the key's user needs permission to manage requests)
OVERSEERR_API_KEY=example-overseerr-api-key

# qBittorrent Web UI (login/password of the Web UI) / (identifiants de l'interface Web)
QBIT_URL=http://192.168.1.10:8080
QBIT_USER=admin
QBIT_PASS=change-me

PLEX_URL=http://192.168.1.10:32400
# Plex token (X-Plex-Token) / jeton Plex
PLEX_TOKEN=example-plex-token

# --- Optional services / Services facultatifs ---
# Prowlarr > Settings > General > API Key
PROWLARR_URL=http://192.168.1.10:9696
PROWLARR_API_KEY=0123456789abcdef0123456789abcdef

# Homarr: ping + "open" link only. HOMARR_OPEN_URL = link address if different (e.g. a Tailscale URL).
# Homarr : ping + lien d'ouverture seulement. HOMARR_OPEN_URL = adresse du lien si elle diffère.
HOMARR_URL=http://192.168.1.10:7575
# HOMARR_OPEN_URL=https://homarr.example.ts.net

# --- ntfy notifications (optional) / Notifications ntfy (facultatif) ---
# Without NTFY_URL AND NTFY_TOPIC the watcher is disabled. / Sans NTFY_URL ET NTFY_TOPIC, la surveillance est désactivée.
# The topic acts as a password on an open ntfy server: make it long and random.
# NTFY_URL=http://192.168.1.10:30060
# NTFY_TOPIC=mediarr-a-long-random-topic
# NTFY_TOKEN=tk_optional_ntfy_access_token
